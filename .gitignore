# ==============================================================================
# Git Ignore - Pharmaceutical Inventory Verification System
# ==============================================================================

# 1. Dependencies (Never commit node_modules)
node_modules/
*/node_modules/
**/node_modules/

# 2. Environment Variables & Credentials (CRITICAL: Never commit database passwords or keys)
.env
.env.*
.env*.local
*.env
!.env.example
!mobile/.env.example
!backend/.env.example

# 3. Expo & React Native Build Outputs
.expo/
*/.expo/
dist/
*/dist/
web-build/
*/web-build/
expo-env.d.ts
*.tsbuildinfo

# 4. Native Android / iOS generated build folders
android/
ios/
.kotlin/
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.apk
*.aab

# 5. Python & Virtual Environments
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# 6. OCR Models, Model Weights, & Cache (Auto-downloaded at runtime - NEVER commit)
backend/cache/
*/cache/
**/cache/
*.traineddata
*.pth
*.pdiparams
*.pdparams
*.pdmodel
*.pdopt
*/ocr-uploads/
ocr-uploads/
uploads/
tmp/

# 7. Temporary / Scratch Scripts & Logs
*.log
backend/uvicorn_*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
start_ocr.py
backend/test_*.py
test_*.py

# 8. OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
